    "security": "npm run security:scan && npm run security:audit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.6.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^16.2.4",
    "next-themes": "^0.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
