VITE_ALLOW_LOCAL_OWNER=false
VITE_LOCAL_OWNER_EMAIL=owner@localhost
VITE_DATA_GOV_NADLAN_RESOURCE_ID=
VITE_ENABLE_SYNTHETIC_GOV_DEMO=false

# Server-only settings for the Vite dev/preview /mvp-api proxy.
# Never prefix the service token with VITE_: VITE_* values are bundled into browser code.
MVP_API_TARGET=http://localhost:3001
MVP_API_SERVICE_TOKEN=
