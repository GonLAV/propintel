{
  "name": "saas-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PropIntel — multi-tenant property appraisal SaaS API (Node.js + Express + PostgreSQL + Redis)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "node scripts/lint.cjs",
    "lint:fix": "node scripts/lint.cjs --fix",
    "test": "jest --runInBand --detectOpenHandles",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles",
    "test:coverage": "jest --coverage --runInBand",
    "migrate": "node-pg-migrate -j sql -d DATABASE_URL -m sql up",
    "migrate:down": "node-pg-migrate -j sql -d DATABASE_URL -m sql down",
    "migrate:create": "node-pg-migrate -j sql -m sql create",
    "seed": "node seed.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "playwright": "^1.56.1",
    "rate-limit-redis": "^4.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.31.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.1.7",
    "pdf-parse": "^1.1.1",
    "supertest": "^7.0.0"
  }
}
