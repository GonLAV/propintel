# =============================================================================
# Application
# =============================================================================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
LOG_LEVEL=info
TRUST_PROXY=1

# CORS - comma-separated list of allowed origins (use * only in dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# PostgreSQL
# =============================================================================
DATABASE_URL=postgres://app:app_password@localhost:5432/saas
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_SSL=false

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=saas:

# =============================================================================
# Auth / JWT
# Generate strong random values:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# =============================================================================
JWT_ACCESS_SECRET=replace_me_with_64_byte_random_hex
JWT_REFRESH_SECRET=replace_me_with_another_64_byte_random_hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=propintel
JWT_AUDIENCE=propintel-clients

BCRYPT_ROUNDS=12

# =============================================================================
# Field-level encryption (AES-256-GCM)
# 32-byte key encoded in hex (64 hex chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =============================================================================
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# =============================================================================
# Rate limiting (Redis-backed)
# =============================================================================
RATE_LIMIT_IP_WINDOW_MS=60000
RATE_LIMIT_IP_MAX=120
RATE_LIMIT_USER_WINDOW_MS=60000
RATE_LIMIT_USER_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10

# =============================================================================
# Cookies (used if you enable cookie-based refresh tokens)
# =============================================================================
COOKIE_SECRET=replace_me_with_random_string
COOKIE_SECURE=false
COOKIE_DOMAIN=

# =============================================================================
# OAuth - Google (structure-ready, not required to enable)
# =============================================================================
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/auth/oauth/google/callback

# =============================================================================
# Report PDF export (Playwright/Chromium)
# =============================================================================
# Where generated report PDFs are written on local disk. Default: <repo>/storage/reports
REPORTS_STORAGE_DIR=
# Override the Chromium binary Playwright launches (e.g. Alpine's native
# /usr/bin/chromium-browser instead of Playwright's own glibc-only download).
# Leave unset locally to use the Playwright-managed browser.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Set to 1 only if the container runtime can't use Chromium's sandbox.
PLAYWRIGHT_CHROMIUM_NO_SANDBOX=
